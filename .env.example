# Reclaim
RECLAIM_APP_ID=
RECLAIM_APP_SECRET=
RECLAIM_REQUIRE_TEE_ATTESTATION=false
RECLAIM_X_PROVIDER_ID=
RECLAIM_X_PROVIDER_VERSION=1.0.6
# Optional Early session commitment override; this is not a Reclaim proof providerHash.
RECLAIM_X_PROVIDER_CONFIGURATION_HASH=
RECLAIM_YOUTUBE_PROVIDER_ID=
RECLAIM_YOUTUBE_PROVIDER_VERSION=1.0.0
RECLAIM_YOUTUBE_PROVIDER_CONFIGURATION_HASH=

# Privy
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_JWT_VERIFICATION_KEY=

# Application security
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_APP_ORIGINS=http://localhost:3000
RAW_PROOF_ENCRYPTION_KEY=
RAW_PROOF_RETENTION_HOURS=24
RETENTION_CRON_SECRET=

# Supabase server storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Base Sepolia
NEXT_PUBLIC_BASE_CHAIN_ID=84532
NEXT_PUBLIC_BASE_REGISTRY_ADDRESS=
NEXT_PUBLIC_BASE_CAMPAIGN_CLAIMS_ADDRESS=
NEXT_PUBLIC_BASE_EXPLORER_URL=https://sepolia.basescan.org
BASE_RPC_URL=https://sepolia.base.org

# Zama Ethereum Sepolia
NEXT_PUBLIC_ZAMA_CHAIN_ID=11155111
NEXT_PUBLIC_ZAMA_VAULT_ADDRESS=
NEXT_PUBLIC_ZAMA_RELAYER_URL=http://localhost:3000/api/zama/relayer/11155111
NEXT_PUBLIC_ZAMA_EXPLORER_URL=https://sepolia.etherscan.io
ZAMA_RELAYER_UPSTREAM_URL=https://relayer.testnet.zama.org/v2
ZAMA_RELAYER_API_KEY=

# Early attestation and eligibility bridge services.
# Production values must be KMS key references, never raw private keys.
EARLY_ATTESTOR_KMS_KEY_ID=
EARLY_BRIDGE_KMS_KEY_ID=
EARLY_ATTESTOR_SERVICE_URL=
EARLY_ATTESTOR_SERVICE_TOKEN=
EARLY_BRIDGE_SERVICE_URL=
EARLY_BRIDGE_SERVICE_TOKEN=
ZAMA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Prelaunch waitlist (server-only Resend key with Contacts read/write access)
RESEND_API_KEY=
RESEND_WAITLIST_SUPPORTER_SEGMENT_ID=
RESEND_WAITLIST_CREATOR_SEGMENT_ID=
RESEND_WAITLIST_BRAND_SEGMENT_ID=
RESEND_WAITLIST_DEVELOPER_SEGMENT_ID=
# Cloudflare Turnstile: required for production waitlist submissions
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Reviewed activity routes; legacy YouTube comment settings above stay separate.
RECLAIM_SPOTIFY_SAVED_TRACK_PROVIDER_ID=486e7100-ea6e-4b82-b2ee-48933a05abc6
RECLAIM_SPOTIFY_SAVED_TRACK_PROVIDER_VERSION=1.0.5
RECLAIM_YOUTUBE_SUBSCRIPTION_PROVIDER_ID=0e7046f2-4a43-448c-9b6f-7d1423525513
RECLAIM_YOUTUBE_SUBSCRIPTION_PROVIDER_VERSION=1.0.4
RECLAIM_YOUTUBE_LIKE_PROVIDER_ID=4b2083cb-dabe-4da1-aea2-b0eeed9166b4
RECLAIM_YOUTUBE_LIKE_PROVIDER_VERSION=1.0.3

# Monad TESTNET only. The browser always uses the official no-key RPC.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_EXPLORER_URL=https://testnet.monadvision.com
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
# Written only after an explicitly authorized deployment.
NEXT_PUBLIC_MONAD_ESCROW_ADDRESS=
MONAD_ESCROW_DEPLOYMENT_BLOCK=
MONAD_DEPLOYER_ACCOUNT=early-monad-deployer
MONAD_ESCROW_ADMIN=
# Public address of the separate eligibility signer, used by the deployment script.
EARLY_ELIGIBILITY_SIGNER_ADDRESS=
# Run node scripts/setup-early-local.mjs to fill missing test-only keys securely.
EARLY_ELIGIBILITY_SIGNER_MODE=local-testnet
EARLY_ELIGIBILITY_PRIVATE_KEY=
EARLY_SOURCE_NULLIFIER_SECRET=
EARLY_SOURCE_NULLIFIER_KEY_VERSION=1

# Server-only indexer endpoint. No endpoint exists until the indexer is started.
ENVIO_GRAPHQL_URL=
# Exact header value; include "Bearer " here only if the endpoint requires it.
ENVIO_GRAPHQL_AUTH_TOKEN=
ENVIO_GRAPHQL_AUTH_HEADER=
# Optional HyperSync token. RPC-only indexing does not require it.
ENVIO_API_TOKEN=
